<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestion des Utilisateurs</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --primary-color: #0077b6;
            --secondary-color: #023e8a;
            --accent-color: #0096c7;
            --light-bg: #f5f9ff;
            --card-bg: #ffffff;
            --hover-bg: #e0faff;
            --border-color: #caf0f8;
            --table-header: #f0f8ff;
        }
        
         * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        body {
            background: linear-gradient(135deg, #f5f9ff, #e6f2ff);
            min-height: 100vh;
            color: #333;
        }
        
        /* Barre de navigation */
       .navbar {
            background: linear-gradient(135deg, #0077b6, #023e8a);
            color: white;
            padding: 0 20px;
            box-shadow: 0 2px 15px rgba(186, 189, 195, 0.3);
            position: sticky;
            top: 0;
            z-index: 100;
        }
        
        .navbar-container {
            max-width: 1400px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 15px 0;
        }
        
         .logo-container {
           display: flex;
            align-items: center;
            gap: 15px;
        }
        
        .logo-placeholder {
           width: 50px;
            height: 50px;
            background: #90e0ef;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
            overflow: hidden;
            cursor: pointer;
            transition: transform 0.3s ease;
        }
        
       .logo-placeholder:hover {
            transform: scale(1.05);
        }
        .logo-placeholder img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            padding: 5px;
        }
        
        .container {
            max-width: 2000px;
            margin: 30px auto;
            padding: 0 20px;
        }
        .admin-title {
           font-size: 1.3rem;
            font-weight: 600;
        }
        
        .admin-title span {
            font-weight: 300;
            opacity: 0.8;
        }
        
         .search-container {
            background: rgba(255,255,255,0.15);
            border-radius: 30px;
            padding: 5px 15px;
            display: flex;
            align-items: center;
            transition: background 0.3s;
            width: 400px;
            max-width: 100%;
        }
        .search-container:hover {
            background: rgba(255,255,255,0.25);
        }
        
        .search-container input, .search-container select {
            background: transparent;
            border: none;
            color: white;
            padding: 8px 5px;
            width: 100%;
            outline: none;
        }
        
        .search-container input::placeholder {
            color: rgba(255,255,255,0.7);
        }
        
        .search-container button {
            background: transparent;
            border: none;
            color: white;
            cursor: pointer;
            font-size: 1rem;
            padding: 5px 10px;
        }
        
        .search-container button:hover {
            transform: scale(1.1);
        }
        
        .filter-container {
            flex-direction: column;
        }
        
        .filter-container select {
            flex: 1;
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 9px;
            color: black;
            padding: 5px;
        }
        
        .filter-container select option {
            background: var(--primary-blue);
        }
        
        /* Contenu principal */
        .container {
            max-width: 2000px;
            margin: 30px auto;
            padding: 0 20px;
        }
        
        h1 {
            font-size: 2rem;
            color: var(--primary-color);
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            position: relative;
            padding-bottom: 10px;
        }
        
        h1:after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 80px;
            height: 4px;
            background: var(--accent-color);
            border-radius: 2px;
        }
        
        .btn-new-agent {
            display: inline-flex;
            align-items: center;
            background: var(--accent-color);
            color: #fff;
            padding: 10px 16px;
            border-radius: 8px;
            text-decoration: none;
            transition: all 0.3s;
            margin-bottom: 25px;
            font-weight: 500;
            border: none;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(0, 118, 182, 0.25);
        }
        
        .btn-new-agent:hover {
            background: var(--primary-color);
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(0, 118, 182, 0.35);
        }
        
        .btn-new-agent i {
            margin-right: 8px;
        }
        
        .card {
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 5px 25px rgba(2, 62, 138, 0.1);
            border: none;
        }
        
        .table-responsive {
            overflow-x: auto;
        }
        
        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 900px;
        }
        
        thead {
            background: var(--table-header);
        }
        
        th {
            padding: 16px 20px;
            text-align: left;
            font-weight: 600;
            color: var(--secondary-color);
            border-bottom: 2px solid var(--border-color);
            position: sticky;
            top: 0;
            background: var(--table-header);
        }
        
        td {
            padding: 14px 20px;
            border-bottom: 1px solid var(--border-color);
            color: #444;
        }
        
        tr:nth-child(even) {
            background: #fafdff;
        }
        
        tr:hover {
            background: var(--hover-bg);
        }
        
        .action-buttons {
            display: flex;
            gap: 8px;
            justify-content: center;
        }
        
        .btn-view, .btn-edit, .btn-delete {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 0.95rem;
            cursor: pointer;
            transition: all 0.3s;
            border: none;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        }
        
        .btn-edit {
            background:rgb(154, 215, 227);
            color: white;
        }
        
        .btn-delete {
            background:rgb(40, 97, 141);
            color: white;
        }
        
        .btn-view:hover, .btn-edit:hover, .btn-delete:hover {
            transform: translateY(-3px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
            background: #0288d1;
        }
        
        .btn-edit:hover {
            transform: translateY(-3px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
        }
        
        .btn-delete:hover {
            background:rgb(72, 215, 228);
        }
        
        .text-center {
            text-align: center;
        }
        
        .empty-state {
            padding: 40px 20px;
            text-align: center;
            color: #7f8c8d;
        }
        
        .empty-state i {
            font-size: 3rem;
            margin-bottom: 15px;
            color: #bdc3c7;
        }
        
        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: var(--accent-color);
            color: white;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            margin-right: 10px;
            font-size: 18px;
        }
        
        .user-info {
            display: flex;
            align-items: center;
        }
        
        .user-name {
            font-weight: normal;
            color: black;
        }
        
        .card-footer {
            background-color: rgba(52, 152, 219, 0.1);
            padding: 12px 20px;
            font-size: 0.9rem;
            color: #7f8c8d;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .birthdate-cell {
            font-size: 0.9rem;
            color: #555;
        }
        
        .role-badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 0.8rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .role-admin {
            background-color: rgba(231, 76, 60, 0.15);
            color: #c0392b;
        }
        
        .role-agent {
            background-color: rgba(46, 204, 113, 0.15);
            color: #27ae60;
        }
        
        .role-manager {
            background-color: rgba(52, 152, 219, 0.15);
            color: #2980b9;
        }
        
        .role-other {
            background-color: rgba(155, 89, 182, 0.15);
            color: #8e44ad;
        }
        
        /* Responsive */
        @media (max-width: 992px) {
            .navbar-container {
                flex-direction: column;
                gap: 20px;
                padding: 15px 0;
            }
            
            .logo-container {
                width: 100%;
                justify-content: center;
            }
            
            .search-container {
                width: 100%;
            }
            
            .container {
                margin: 20px auto;
            }
            
            h1 {
                font-size: 1.8rem;
            }
        }
        
        @media (max-width: 768px) {
            .filter-container {
                flex-direction: column;
            }
            
            .table-responsive {
                border-radius: 10px;
            }
            
            .btn-new-agent {
                padding: 8px 14px;
                font-size: 0.95rem;
            }
            
            th, td {
                padding: 12px 15px;
            }
        }
        
        /* Animation pour les lignes du tableau */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        tbody tr {
            animation: fadeIn 0.4s ease-out;
            animation-fill-mode: backwards;
        }
        
        tbody tr:nth-child(1) { animation-delay: 0.1s; }
        tbody tr:nth-child(2) { animation-delay: 0.2s; }
        tbody tr:nth-child(3) { animation-delay: 0.3s; }
        tbody tr:nth-child(4) { animation-delay: 0.4s; }
        tbody tr:nth-child(5) { animation-delay: 0.5s; }
        tbody tr:nth-child(6) { animation-delay: 0.6s; }
        tbody tr:nth-child(7) { animation-delay: 0.7s; }
        tbody tr:nth-child(8) { animation-delay: 0.8s; }
        tbody tr:nth-child(9) { animation-delay: 0.9s; }
        tbody tr:nth-child(10) { animation-delay: 1.0s; }

         /* Style pour le bouton de retour */
        .back-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #5a5c69;
            color: white;
            padding: 12px 25px;
            border-radius: 8px;
            text-decoration: none;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
            font-size: 1rem;
            font-weight: 600;
            margin: 20px auto;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
        }
        
        .back-btn:hover {
            background: #4e5060;
            transform: translateY(-3px);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
        }

         .back-btn i {
            margin-right: 10px;
        }
        
        .button-container {
            display: flex;
            justify-content: center;
            width: 100%;
        }

        /* Nouveau séparateur */
        .separator {
            width: 600px;
            height: 40px;
            background-color: transparent;
            margin: 0 20px;
        }
        
        /* Espace entre le logo et la barre de recherche */
        .spacer {
            flex: 1;
        }
        
    </style>
</head>
<body>
    <!-- Barre de navigation -->
    <nav class="navbar">
        <div class="navbar-container">
            <div class="logo-container">
                <div class="logo-placeholder" id="reset-logo">
                    <img src="https://medinagroup.com.tn/lapaix/img/medina_logo.png" alt="Logo">
                </div>
                <div class="admin-title">
                    ADMIN <span>| Gestion des Utilisateurs</span>
                </div>
            </div>
            <div class="separator"></div>
            <div class="search-container">
                <input type="text" id="search-input" placeholder="Rechercher un utilisateur...">
                <button id="search-button">
                    <i class="fas fa-search"></i>
                </button>
                
                <div class="filter-container">
                    <select id="filter-field">
                        <option value="nom">Nom/Prénom</option>
                        <option value="email">Email</option>
                        <option value="telephone">Téléphone</option>
                        <option value="role">Rôle</option>
                    </select>
                </div>
            </div>
        </div>
    </nav>

    <div class="container mt-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="page-header">
                <i class="bi bi-people-fill me-2"></i>Gestion des Utilisateurs
            </h1>
            <a href="{{ path('app_user_new') }}" class="btn-new-agent">
                <i class="bi bi-plus-circle me-2"></i> Nouvel Utilisateur
            </a>
        </div>

        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Utilisateur</th>
                                <th>Date de Naissance</th>
                                <th>Email</th>
                                <th>Téléphone</th>
                                <th>Rôle</th>
                               
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for user in users %}
                                <tr>
                                    <td>{{ user.id }}</td>
                                    <td>
                                        <div class="user-info">
                                            <div class="user-avatar">
                                                {{ user.nom|first }}{{ user.prenom|first }}
                                            </div>
                                            <div>
                                                <div class="user-name">{{ user.prenom }} {{ user.nom }}</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="birthdate-cell">
                                        {% if user.dateNaissance %}
                                            {{ user.dateNaissance|date('d/m/Y') }}
                                        {% else %}
                                            -
                                        {% endif %}
                                    </td>
                                    <td>{{ user.email }}</td>
                                    <td>{{ user.telephone }}</td>
                                    <td>
                                        {% if user.role == 'Admin' %}
                                            <span class="role-badge role-admin">Admin</span>
                                        {% elseif user.role == 'Agent de saisie' %}
                                            <span class="role-badge role-agent">Agent</span>
                                        {% elseif user.role == 'Manager' %}
                                            <span class="role-badge role-manager">Manager</span>
                                        {% else %}
                                            <span class="role-badge role-other">{{ user.role }}</span>
                                        {% endif %}
                                    </td>
                                    
                                    <td class="text-center">
                                        <div class="action-buttons">
                                            <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn-edit" title="Modifier">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a href="#" class="btn-delete" title="Supprimer" 
                                               onclick="if(confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur?')) { 
                                                   document.getElementById('delete-form-{{ user.id }}').submit(); 
                                               } return false;">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                            <form id="delete-form-{{ user.id }}" 
                                                  action="{{ path('app_user_delete', {'id': user.id}) }}" 
                                                  method="post" style="display: none;">
                                                <input type="hidden" name="_method" value="DELETE">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="7" class="text-center py-5">
                                        <div class="empty-state">
                                            <i class="bi bi-people"></i>
                                            <h4>Aucun utilisateur trouvé</h4>
                                            <p>Commencez par ajouter un nouvel utilisateur</p>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    
                </div>
            </div>
            
            <div class="card-footer">
                <div>
                    <i class="bi bi-info-circle me-2"></i>
                    Total: {{ users|length }} utilisateur(s)
                </div>
                <div>
                    <i class="bi bi-clock-history me-2"></i>
                    Dernière mise à jour: {{ "now"|date("d/m/Y H:i") }}
                </div>
            </div>
        </div>
    </div>

     <!-- Bouton de retour au tableau de bord -->
    <div class="button-container">
        <a href="{{ path('app_admin_dashboard') }}" class="back-btn">
            <i class="fas fa-arrow-left"></i> Retour au tableau de bord
        </a>
    </div>

    <script>
        // Fonctionnalité de recherche/filtrage
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('search-input');
            const filterField = document.getElementById('filter-field');
            const searchButton = document.getElementById('search-button');
            const tableRows = document.querySelectorAll('tbody tr');
            const resetLogo = document.getElementById('reset-logo');
            
            // Fonction pour filtrer les utilisateurs
            function filterUsers() {
                const searchTerm = searchInput.value.toLowerCase();
                const field = filterField.value;
                
                tableRows.forEach(row => {
                    // Ignorer la ligne "Aucun utilisateur trouvé"
                    if (row.cells.length < 7) return;
                    
                    let cellValue = '';
                    
                    switch(field) {
                        case 'nom':
                            const nom = row.cells[1].textContent.toLowerCase();
                            cellValue = nom;
                            break;
                        case 'email':
                            cellValue = row.cells[3].textContent.toLowerCase();
                            break;
                        case 'telephone':
                            cellValue = row.cells[4].textContent.toLowerCase();
                            break;
                        case 'role':
                            cellValue = row.cells[5].textContent.toLowerCase();
                            break;
                    }
                    
                    if (cellValue.includes(searchTerm)) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            }
            
            // Réinitialiser la page au clic sur le logo
            resetLogo.addEventListener('click', function() {
                searchInput.value = '';
                filterField.value = 'nom';
                
                // Réafficher toutes les lignes
                tableRows.forEach(row => {
                    row.style.display = '';
                });
            });
            
            // Événements pour la recherche
            searchButton.addEventListener('click', filterUsers);
            searchInput.addEventListener('keyup', function(e) {
                if (e.key === 'Enter') {
                    filterUsers();
                }
            });
            
            filterField.addEventListener('change', filterUsers);

            
        });


    </script>
</body>
</html>