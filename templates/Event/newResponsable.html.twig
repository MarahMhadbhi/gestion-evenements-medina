{% extends 'base.html.twig' %}

{% block title %}Créer un nouvel événement{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Variables de couleurs */
        :root {
            --primary: #4361ee;
            --secondary: #7209b7;
            --light: #f8f9ff;
            --dark: #212529;
            --success: #06d6a0;
            --gray: #8d99ae;
        }
        
        .form-container {
            max-width: 900px;
            margin: 40px auto;
            padding: 40px;
            background: white;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            border: 1px solid #eef2f7;
        }
        
        .form-header {
            text-align: center;
            margin-bottom: 40px;
        }
        
        .form-header h1 {
            color: var(--primary);
            font-weight: 700;
            font-size: 2.2rem;
            position: relative;
            display: inline-block;
            padding-bottom: 15px;
        }
        
        .form-header h1:after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 80px;
            height: 4px;
            background: linear-gradient(to right, var(--primary), var(--secondary));
            border-radius: 2px;
        }
        
        .form-column {
            padding: 20px;
            background: var(--light);
            border-radius: 12px;
            margin-bottom: 20px;
            transition: transform 0.3s, box-shadow 0.3s;
        }
        
        .form-column:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(67, 97, 238, 0.1);
        }
        
        .form-group {
            margin-bottom: 25px;
        }
        
        .form-label {
            display: block;
            margin-bottom: 10px;
            font-weight: 600;
            color: var(--dark);
            font-size: 1.05rem;
        }
        
        .form-control {
            width: 100%;
            padding: 14px 18px;
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            font-size: 1rem;
            transition: all 0.3s;
            background: white;
        }
        
        .form-control:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(67, 97, 238, 0.15);
            outline: none;
        }
        
        textarea.form-control {
            min-height: 180px;
            resize: vertical;
        }
        
        .file-input-container {
            position: relative;
            border: 2px dashed #cbd5e0;
            border-radius: 10px;
            padding: 30px 20px;
            text-align: center;
            background: white;
            transition: all 0.3s;
        }
        
        .file-input-container:hover {
            border-color: var(--primary);
            background-color: rgba(67, 97, 238, 0.03);
        }
        
        .file-input-label {
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
            color: var(--gray);
        }
        
        .file-input-label i {
            font-size: 2.5rem;
            color: var(--primary);
            margin-bottom: 15px;
        }
        
        .file-input-label span {
            font-weight: 600;
            color: var(--primary);
            text-decoration: underline;
        }
        
        .file-input {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            cursor: pointer;
        }
        
        .btn-container {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 30px;
        }
        
        .btn {
            padding: 14px 36px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 1.05rem;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            transition: all 0.3s;
            border: none;
            cursor: pointer;
        }
        
        .btn-primary {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            box-shadow: 0 6px 15px rgba(67, 97, 238, 0.3);
        }
        
        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(67, 97, 238, 0.4);
        }
        
        .btn-outline {
            background: transparent;
            color: var(--primary);
            border: 2px solid var(--primary);
        }
        
        .btn-outline:hover {
            background: rgba(67, 97, 238, 0.05);
        }
        
        .invalid-feedback {
            color: #e53e3e;
            font-weight: 500;
            margin-top: 8px;
            display: block;
        }
        
        .is-invalid {
            border-color: #e53e3e;
        }
        
        .is-invalid:focus {
            box-shadow: 0 0 0 4px rgba(229, 62, 62, 0.15);
        }
        
        @media (max-width: 768px) {
            .form-container {
                padding: 25px 20px;
            }
            
            .btn-container {
                flex-direction: column;
                gap: 12px;
            }
            
            .btn {
                width: 100%;
                justify-content: center;
            }


              .sponsors-container {
            margin-top: 25px;
        }
        
        .sponsor-preview {
            display: inline-block;
            position: relative;
            margin: 10px;
        }
        
        .sponsor-preview img {
            max-height: 80px;
            max-width: 150px;
            border-radius: 8px;
            border: 1px solid #e2e8f0;
            padding: 5px;
            background: white;
        }
        
        .remove-sponsor {
            position: absolute;
            top: -10px;
            right: -10px;
            background: #e53e3e;
            color: white;
            border-radius: 50%;
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 12px;
            border: none;
        }
        }

        

    </style>
{% endblock %}

{% block body %}
<div class="container">
    <div class="form-container">
        <div class="form-header">
            <h1>Créer un nouvel événement</h1>
        </div>

        {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
            <div class="row">
                <div class="col-md-6">
                    <div class="form-column">
                        <div class="form-group">
                            {{ form_label(form.titre, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.titre, {'attr': {'class': 'form-control'}}) }}
                            <div class="invalid-feedback">
                                {{ form_errors(form.titre) }}
                            </div>
                        </div>

                        <div class="form-group">
                            {{ form_label(form.dateDebut, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.dateDebut, {'attr': {'class': 'form-control'}}) }}
                            <div class="invalid-feedback">
                                {{ form_errors(form.dateDebut) }}
                            </div>
                        </div>

                        <div class="form-group">
                            {{ form_label(form.dateFin, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.dateFin, {'attr': {'class': 'form-control'}}) }}
                            <div class="invalid-feedback">
                                {{ form_errors(form.dateFin) }}
                            </div>
                        </div>

                        <div class="form-group">
                            {{ form_label(form.lieu, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.lieu, {'attr': {'class': 'form-control'}}) }}
                            <div class="invalid-feedback">
                                {{ form_errors(form.lieu) }}
                             </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-column">
                        <div class="form-group">
                            {{ form_label(form.description, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 6}}) }}
                            <div class="invalid-feedback">
                                {{ form_errors(form.description) }}
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Logo de l'événement</label>
                            <div class="file-input-container">
                                <label class="file-input-label">
                                    <i class="fas fa-cloud-upload-alt"></i>
                                    <div>Glissez-déposez votre fichier ou <span>parcourir</span></div>
                                    <small>Formats: JPG, PNG, GIF (max 2MB)</small>
                                </label>
                                {{ form_widget(form.logoFile, {'attr': {'class': 'file-input'}}) }}
                            </div>
                            <div class="invalid-feedback">
                                {{ form_errors(form.logoFile) }}
                            </div>
                        </div>

                         <div class="form-group">
                            <label class="form-label">Logos des sponsors</label>
                            <div class="file-input-container">
                                <label class="file-input-label">
                                    <i class="fas fa-images"></i>
                                    <div>Glissez-déposez vos fichiers ou <span>parcourir</span></div>
                                    <small>Formats: JPG, PNG, GIF (max 2MB chacun)</small>
                                </label>
                                <input type="file" 
                                       id="sponsor_logos" 
                                        name="sponsor_logos[]"
                                       class="file-input" 
                                       multiple
                                       accept="image/*">
                            </div>
                            <div id="sponsor-logos-error" class="invalid-feedback"></div>

                             <div class="sponsors-container">
                                <div id="sponsor-previews"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="btn-container">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Enregistrer
                </button>
                <a href="{{ path('app_respo_event_index') }}" class="btn btn-outline">
                    <i class="fas fa-arrow-left"></i> Retour à la liste
                </a>
            </div>
        {{ form_end(form) }}
    </div>
</div>

<script>
document.getElementById('sponsor_logos').addEventListener('change', function(e) {
    const previewContainer = document.getElementById('sponsor-previews');
    previewContainer.innerHTML = '';

    Array.from(e.target.files).forEach(file => {
        if (!file.type.match('image.*')) {
            document.getElementById('sponsor-logos-error').textContent = 'Format invalide (JPG/PNG/GIF seulement)';
            return;
        }

        const reader = new FileReader();
        reader.onload = function(e) {
            const img = document.createElement('img');
            img.src = e.target.result;
            img.style.maxWidth = '100px';
            img.style.maxHeight = '80px';
            img.style.margin = '5px';
            previewContainer.appendChild(img);
        };
        reader.readAsDataURL(file);
    });
});
</script>
{% endblock %}