{% extends 'base.html.twig' %}

{% block title %}Modifier l'événement{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Variables de couleurs */
        :root {
            --primary: #4361ee;
            --secondary: #7209b7;
            --light: #f8f9ff;
            --dark: #212529;
            --success: #06d6a0;
            --gray: #8d99ae;
        }
        
        .form-container {
            max-width: 900px;
            margin: 40px auto;
            padding: 40px;
            background: white;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            border: 1px solid #eef2f7;
        }
        
        .form-header {
            text-align: center;
            margin-bottom: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap;
        }
        
        .form-header h1 {
            color: var(--primary);
            font-weight: 700;
            font-size: 2.2rem;
            position: relative;
            padding-bottom: 15px;
            margin: 0;
        }
        
        .form-header h1:after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 80px;
            height: 4px;
            background: linear-gradient(to right, var(--primary), var(--secondary));
            border-radius: 2px;
        }
        
        .current-logo-container {
            text-align: center;
            margin: 20px 0;
        }
        
        .current-logo {
            max-width: 200px;
            max-height: 150px;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            border: 1px solid #eaeaea;
            padding: 5px;
            background: white;
        }
        
        .logo-placeholder {
            width: 200px;
            height: 150px;
            background: var(--light);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--gray);
            font-weight: 500;
            border: 2px dashed #cbd5e0;
            margin: 0 auto;
        }
        
        .form-column {
            padding: 20px;
            background: var(--light);
            border-radius: 12px;
            margin-bottom: 20px;
            transition: transform 0.3s, box-shadow 0.3s;
        }
        
        .form-column:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(67, 97, 238, 0.1);
        }
        
        .form-group {
            margin-bottom: 25px;
        }
        
        .form-label {
            display: block;
            margin-bottom: 10px;
            font-weight: 600;
            color: var(--dark);
            font-size: 1.05rem;
        }
        
        .form-control {
            width: 100%;
            padding: 14px 18px;
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            font-size: 1rem;
            transition: all 0.3s;
            background: white;
        }
        
        .form-control:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(67, 97, 238, 0.15);
            outline: none;
        }
        
        textarea.form-control {
            min-height: 180px;
            resize: vertical;
        }
        
        .file-input-container {
            position: relative;
            border: 2px dashed #cbd5e0;
            border-radius: 10px;
            padding: 30px 20px;
            text-align: center;
            background: white;
            transition: all 0.3s;
        }
        
        .file-input-container:hover {
            border-color: var(--primary);
            background-color: rgba(67, 97, 238, 0.03);
        }
        
        .file-input-label {
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
            color: var(--gray);
        }
        
        .file-input-label i {
            font-size: 2.5rem;
            color: var(--primary);
            margin-bottom: 15px;
        }
        
        .file-input-label span {
            font-weight: 600;
            color: var(--primary);
            text-decoration: underline;
        }
        
        .file-input {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            cursor: pointer;
        }
        
        .btn-container {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 30px;
        }
        
        .btn {
            padding: 14px 36px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 1.05rem;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            transition: all 0.3s;
            border: none;
            cursor: pointer;
        }
        
        .btn-primary {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            box-shadow: 0 6px 15px rgba(67, 97, 238, 0.3);
        }
        
        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(67, 97, 238, 0.4);
        }
        
        .btn-outline {
            background: transparent;
            color: var(--primary);
            border: 2px solid var(--primary);
        }
        
        .btn-outline:hover {
            background: rgba(67, 97, 238, 0.05);
        }
        
        .invalid-feedback {
            color: #e53e3e;
            font-weight: 500;
            margin-top: 8px;
            display: block;
        }
        
        .is-invalid {
            border-color: #e53e3e;
        }
        
        .is-invalid:focus {
            box-shadow: 0 0 0 4px rgba(229, 62, 62, 0.15);
        }


        .sponsors-section {
            margin-top: 30px;
            padding: 20px;
            background: var(--light);
            border-radius: 12px;
        }

        .sponsor-logos-container {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            margin: 20px 0;
        }

        .sponsor-logo-item {
            position: relative;
            width: 150px;
            text-align: center;
        }

        .sponsor-logo-img {
            width: 100%;
            height: 100px;
            object-fit: contain;
            border: 1px solid #eee;
            border-radius: 8px;
            padding: 5px;
            background: white;
            box-shadow: 0 3px 10px rgba(0,0,0,0.05);
        }

        .sponsor-delete-checkbox {
            margin-top: 10px;
        }

         .sponsor-delete-label {
            display: flex;
            align-items: center;
            gap: 5px;
            cursor: pointer;
            font-size: 0.9rem;
            color: #e53e3e;
        }

        .new-sponsors-container {
            margin-top: 30px;
        }
        
        @media (max-width: 768px) {
            .form-container {
                padding: 25px 20px;
            }
            
            .form-header {
                flex-direction: column;
                gap: 15px;
            }
            
            .btn-container {
                flex-direction: column;
                gap: 12px;
            }
            
            .btn {
                width: 100%;
                justify-content: center;
            }

           
        }
    </style>
{% endblock %}

{% block body %}
<div class="container">
    <div class="form-container">
        <div class="form-header">
            <h1>Modifier l'événement</h1>
            
            <div class="current-logo-container">
                {% if event.logo %}
                    <img src="{{ asset('uploads/logos/' ~ event.logo) }}" 
                         alt="Logo actuel" 
                         class="current-logo">
                {% else %}
                    <div class="logo-placeholder">
                        Aucun logo
                    </div>
                {% endif %}
            </div>
        </div>

        {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
            <div class="row">
                <div class="col-md-6">
                    <div class="form-column">
                        <div class="form-group">
                            {{ form_label(form.titre, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.titre, {'attr': {'class': 'form-control'}}) }}
                            <div class="invalid-feedback">
                                {{ form_errors(form.titre) }}
                            </div>
                        </div>

                        <div class="form-group">
                            {{ form_label(form.dateDebut, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.dateDebut, {'attr': {'class': 'form-control'}}) }}
                            <div class="invalid-feedback">
                                {{ form_errors(form.dateDebut) }}
                            </div>
                        </div>

                        <div class="form-group">
                            {{ form_label(form.dateFin, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.dateFin, {'attr': {'class': 'form-control'}}) }}
                            <div class="invalid-feedback">
                                {{ form_errors(form.dateFin) }}
                            </div>
                        </div>

                        <div class="form-group">
                            {{ form_label(form.lieu, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.lieu, {'attr': {'class': 'form-control'}}) }}
                            <div class="invalid-feedback">
                                {{ form_errors(form.lieu) }}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-column">
                        <div class="form-group">
                            {{ form_label(form.description, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 6}}) }}
                            <div class="invalid-feedback">
                                {{ form_errors(form.description) }}
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Modifier le logo</label>
                            <div class="file-input-container">
                                <label class="file-input-label">
                                    <i class="fas fa-cloud-upload-alt"></i>
                                    <div>Glissez-déposez votre fichier ou <span>parcourir</span></div>
                                    <small>Laisser vide pour conserver le logo actuel</small>
                                    <small class="d-block mt-2">Formats: JPG, PNG, GIF (max 2MB)</small>
                                </label>
                                {{ form_widget(form.logoFile, {'attr': {'class': 'file-input'}}) }}
                            </div>
                            <div class="invalid-feedback">
                                {{ form_errors(form.logoFile) }}
                            </div>
                        </div>


                        <div class="form-group new-sponsors-container">
                            {{ form_label(form.sponsorLogosFiles, null, {'label_attr': {'class': 'form-label'}}) }}
                            <div class="file-input-container">
                                <label class="file-input-label">
                                    <i class="fas fa-cloud-upload-alt"></i>
                                    <div>Glissez-déposez vos fichiers ou <span>parcourir</span></div>
                                    <small>Vous pouvez sélectionner plusieurs fichiers</small>
                                    <small class="d-block mt-2">Formats: JPG, PNG, GIF (max 2MB)</small>
                                </label>
                                {{ form_widget(form.sponsorLogosFiles, {'attr': {'class': 'file-input'}}) }}
                            </div>
                            <div class="invalid-feedback">
                                {{ form_errors(form.sponsorLogosFiles) }}
                            </div>

                         </div>
                    </div>
                </div>
            </div>

             <div class="sponsors-section">
                <h4>Logos Sponsors Existants</h4>
                {% if existingSponsorLogos is not empty %}
                    <p>Cochez les logos que vous souhaitez supprimer :</p>
                    <div class="sponsor-logos-container">
                        {% for logo in existingSponsorLogos %}
                            <div class="sponsor-logo-item">
                                <img src="{{ asset('uploads/sponsors/' ~ logo) }}" 
                                     alt="Logo sponsor" 
                                     class="sponsor-logo-img">
                                <div class="sponsor-delete-checkbox">
                                    <label class="sponsor-delete-label">
                                        <input type="checkbox" 
                                               name="sponsorLogosToRemove[]" 
                                               value="{{ logo }}">
                                        Supprimer
                                    </label>
                                </div>
                            </div>
                        {% endfor %}

            
                  </div>
                {% else %}
                    <p>Aucun logo sponsor pour le moment.</p>
                {% endif %}
            </div>
                          
        
                
                        

                    
              
         <div class="btn-container">
       <button type="submit" class="btn btn-primary">
        <i class="fas fa-edit"></i> Mettre à jour
    </button>
    <a href="{{ path('app_event_index') }}" class="btn btn-outline">
        <i class="fas fa-arrow-left"></i> Retour à la liste
    </a>
       </div>
        {{ form_end(form) }}
</div>
</div>
{% endblock %}