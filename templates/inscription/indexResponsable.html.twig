<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestion des inscriptions</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary-color: #0077b6;
            --secondary-color: #023e8a;
            --accent-color: #0096c7;
            --light-bg: #f5f9ff;
            --card-bg: #ffffff;
            --hover-bg: #e0faff;
            --border-color: #caf0f8;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        body {
            background: linear-gradient(135deg, #f5f9ff, #e6f2ff);
            min-height: 100vh;
            color: #333;
        }
        
        /* Barre de navigation */
        .navbar {
            background: linear-gradient(135deg, #0077b6, #023e8a);
            color: white;
            padding: 0 20px;
            box-shadow: 0 2px 15px rgba(186, 189, 195, 0.3);
            position: sticky;
            top: 0;
            z-index: 100;
        }
        
        .navbar-container {
            max-width: 1400px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 15px 0;
        }
        
        .logo-container {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .spacer {
        flex-grow: 1;
        min-width: 20px;
        }
        
        .logo-placeholder {
            width: 50px;
            height: 50px;
            background: #90e0ef;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
            overflow: hidden;
            cursor: pointer;
            transition: transform 0.3s ease;
        }
        
        .logo-placeholder:hover {
            transform: scale(1.05);
        }
        
        .logo-placeholder img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            padding: 5px;
        }
        
        .admin-title {
           font-size: 1.3rem;
            font-weight: 600;
        }
        
        .admin-title span {
            font-weight: 300;
            opacity: 0.8;
        }
        
        .search-container {
            background: rgba(255,255,255,0.15);
            border-radius: 30px;
            padding: 5px 15px;
            display: flex;
            align-items: center;
            transition: background 0.3s;
            width: 400px;
            max-width: 100%;
        }
        
         .search-container:hover {
            background: rgba(255,255,255,0.25);
        }
        
       .search-container input, .search-container select {
            background: transparent;
            border: none;
            color: white;
            padding: 8px 5px;
            width: 100%;
            outline: none;
        }
        
       .search-container input::placeholder {
            color: rgba(255,255,255,0.7);
        }
        
        .search-container button {
            background: transparent;
            border: none;
            color: white;
            cursor: pointer;
            font-size: 1rem;
            padding: 5px 10px;
        }
        
        
        .search-container button:hover {
            transform: scale(1.1);
        }
        
           .filter-container {
                flex-direction: column;
            }
        
       .filter-container select {
            flex: 1;
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 4px;
            color: black;
            padding: 5px;
        }

        .filter-container select option {
            background: var(--primary-blue);
        }
        
        /* Contenu principal */
       .container {
            max-width: 2000px;
            margin: 30px auto;
            padding: 0 20px;
        }
        
         h1 {
            font-size: 2rem;
            color: var(--primary-color);
            margin-bottom: 20px;
            display: flex;
            align-items: center;
        }
        
        h1:after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 80px;
            height: 4px;
            background: var(--accent-blue);
            border-radius: 2px;
        }
        
        .btn-primary {
          
            display: inline-flex;
            align-items: center;
            background: var(--accent-color);
            color: #fff;
            padding: 10px 16px;
            border-radius: 8px;
            text-decoration: none;
            transition: all 0.3s;
            margin-bottom: 25px;
            font-weight: 500;
            border: none;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(0, 118, 182, 0.25);
        }
        
        .btn-primary:hover {
            background: var(--primary-color);
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(0, 118, 182, 0.35);
        }
        
        .btn-primary i {
             margin-right: 8px;
        }
        
        .table-responsive {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 5px 25px rgba(2, 62, 138, 0.1);
            margin-bottom: 40px;
            overflow-x: auto;
        }
        
        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 1000px;
        }
        
        thead {
            background: var(--table-header);
        }
        
        th {
            padding: 16px 20px;
            text-align: left;
            font-weight: 600;
            color: var(--secondary-blue);
            border-bottom: 2px solid var(--border-color);
            position: sticky;
            top: 0;
            background: var(--table-header);
        }
        
        td {
            padding: 14px 20px;
            border-bottom: 1px solid var(--border-color);
            color: #444;
        }
        
        tr:nth-child(even) {
            background: #fafdff;
        }
        
        tr:hover {
            background: var(--light-blue);
        }
        
        .actions {
            display: flex;
            gap: 8px;
        }
        
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 0.95rem;
            cursor: pointer;
            transition: all 0.3s;
            border: none;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        }
        
          .btn-info {
            background: rgb(101, 194, 197);
            color: white;
        }
        
        .btn-warning {
            background:rgb(154, 215, 227);
            color: white;
        }
        
        .btn-danger {
            background:rgb(40, 97, 141);
            color: white;
            
            
        }
        
        .btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
        }
        
        .btn-info:hover {
            background: #0288d1;
        }
        
        .btn-warning:hover {
             background:rgb(72, 215, 228);
        }
        
        .btn-danger:hover {
           background:rgb(72, 215, 228);
        }
        
        .text-center {
            text-align: center;
        }
        
        /* Responsive */
        @media (max-width: 992px) {
            .navbar-container {
                flex-direction: column;
                gap: 20px;
                padding: 15px 0;
            }
            
            .logo-container {
                width: 100%;
                justify-content: center;
            }

            @media (max-width: 992px) {
    .spacer {
        display: none;
    }
}
            
            .search-container {
                width: 100%;
            }
            
            .container {
                margin: 20px auto;
            }
            
            h1 {
                font-size: 1.8rem;
            }
        }
        
        @media (max-width: 768px) {
            .filter-container {
                flex-direction: column;
            }
            
            .table-responsive {
                border-radius: 10px;
            }
            
            .btn-primary {
                padding: 8px 14px;
                font-size: 0.95rem;
            }
            
            th, td {
                padding: 12px 15px;
            }
        }
        
        /* Animation pour les lignes du tableau */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        tbody tr {
            animation: fadeIn 0.4s ease-out;
            animation-fill-mode: backwards;
        }
        
        tbody tr:nth-child(1) { animation-delay: 0.1s; }
        tbody tr:nth-child(2) { animation-delay: 0.2s; }
        tbody tr:nth-child(3) { animation-delay: 0.3s; }
        tbody tr:nth-child(4) { animation-delay: 0.4s; }
        tbody tr:nth-child(5) { animation-delay: 0.5s; }
        tbody tr:nth-child(6) { animation-delay: 0.6s; }
        tbody tr:nth-child(7) { animation-delay: 0.7s; }
        tbody tr:nth-child(8) { animation-delay: 0.8s; }
        tbody tr:nth-child(9) { animation-delay: 0.9s; }
        tbody tr:nth-child(10) { animation-delay: 1.0s; }

        /* Style pour le bouton de retour */
        .back-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #5a5c69;
            color: white;
            padding: 12px 25px;
            border-radius: 8px;
            text-decoration: none;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
            font-size: 1rem;
            font-weight: 600;
            margin: 20px auto;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
        }
        
        .back-btn:hover {
            background: #4e5060;
            transform: translateY(-3px);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
        }

        
        
        .back-btn i {
            margin-right: 10px;
        }
        
        .button-container {
            display: flex;
            justify-content: center;
            width: 100%;
        }
    </style>
</head>
<body>
    <!-- Barre de navigation -->
    <nav class="navbar">
        <div class="navbar-container">
            <div class="logo-container">
           
                <div class="logo-placeholder" id="reset-logo">
                    <img src="https://medinagroup.com.tn/lapaix/img/medina_logo.png" alt="Logo">
                </div>
                <div class="admin-title">
                    REPONSABLE MARKETING <span>| Gestion des inscriptions</span>
                </div>
                </div>
                   <div class="spacer"></div>
                <div>
             </div>
            <div class="search-container">
                <input type="text" id="search-input" placeholder="Rechercher une inscription...">
                <button id="search-button">
                    <i class="fas fa-search"></i>
                </button>
                
                <div class="filter-container">
                    <select id="filter-field">
                        <option value="nom">Nom/Prénom</option>
                        <option value="type">Type</option>
                    </select>
                </div>
            </div>
        </div>
    </nav>

    <div class="container mt-5">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="page-header">
                <i class="bi bi-people-fill me-2"></i>Gestion des inscriptions
        </h1>
        <a href="{{ path('responsable_inscription_new') }}" class="btn-primary">
            <i class="fas fa-plus"></i> Nouvelle inscription
        </a>
      </div>
        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nom</th>
                        <th>Prénom</th>
                        <th>Email</th>
                        <th>Téléphone</th>
                        <th>Date Naissance</th> 
                        <th>Secteur d'Activité</th>  
                        <th>Nationalite</th>  
                        <th>Type</th>
                        <th>Evenement</th>
                        <th>Date Inscription</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for inscription in inscriptions %}
                    <tr>
                        <td>{{ inscription.id }}</td>
                        <td>{{ inscription.nomClient }}</td>
                        <td>{{ inscription.prenomClient }}</td>
                        <td>{{ inscription.email }}</td>
                        <td>{{ inscription.telephone }}</td>
                        <td>{{ inscription.dateNaissance ? inscription.dateNaissance|date('d/m/Y') : '' }}</td>
                        <td>{{ inscription.secteurActivite }}</td> 
                        <td>{{ inscription.nationalite }}</td>
                        <td>{{ inscription.type }}</td>
                        <td>{{ inscription.event.titre }}</td>
                        <td>{{ inscription.dateInscription|date('d/m/Y H:i') }}</td>
                        <td class="actions">
                            <a href="{{ path('responsable_inscription_badge', {'id': inscription.id}) }}" class="btn btn-info" title="Afficher badge">
                                 <i class="fas fa-eye"></i>
                            </a>
                            <a href="{{ path('responsable_inscription_edit', {'id': inscription.id}) }}" class="btn btn-warning">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form method="post" action="{{ path('responsable_inscription_delete', {'id': inscription.id}) }}" style="display:inline-block" onsubmit="return confirm('Êtes-vous sûr?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ inscription.id) }}">
                                <button type="submit" class="btn btn-danger">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="12" class="text-center">Aucune inscription trouvée</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

    </div>
    <!-- Bouton de retour au tableau de bord -->
    <div class="button-container">
              <a href="{{ path('app_responsable_dashboard') }}" class="back-btn">
            <i class="fas fa-arrow-left"></i> Retour au tableau de bord
        </a>
    
    </div>

    <script>
        // Fonctionnalité de recherche/filtrage
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('search-input');
            const filterField = document.getElementById('filter-field');
            const searchButton = document.getElementById('search-button');
            const tableRows = document.querySelectorAll('tbody tr');
            const resetLogo = document.getElementById('reset-logo');
            
            // Fonction pour filtrer les inscriptions
            function filterInscriptions() {
                const searchTerm = searchInput.value.toLowerCase();
                const field = filterField.value;
                
                tableRows.forEach(row => {
                    // Ignorer la ligne "Aucune inscription trouvée"
                    if (row.cells.length < 12) return;
                    
                    let cellValue = '';
                    
                    switch(field) {
                        case 'nom':
                            const nom = row.cells[1].textContent.toLowerCase();
                            const prenom = row.cells[2].textContent.toLowerCase();
                            cellValue = nom + " " + prenom;
                            break;
                        case 'type':
                            cellValue = row.cells[8].textContent.toLowerCase();
                            break;
                    }
                    
                    if (cellValue.includes(searchTerm)) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            }
            
            // Réinitialiser la page au clic sur le logo
            resetLogo.addEventListener('click', function() {
                searchInput.value = '';
                filterField.value = 'nom';
                
                // Réafficher toutes les lignes
                tableRows.forEach(row => {
                    row.style.display = '';
                });
            });
            
            // Événements pour la recherche
            searchButton.addEventListener('click', filterInscriptions);
            searchInput.addEventListener('keyup', function(e) {
                if (e.key === 'Enter') {
                    filterInscriptions();
                }
            });
            
            filterField.addEventListener('change', filterInscriptions);
        });
    </script>
</body>
</html> 