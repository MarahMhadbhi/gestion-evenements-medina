

{% block title %}Détails de l'inscription{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Détails de l'inscription</h1>

    <div class="card">
        <div class="card-body">
            <table class="table table-bordered">
                <tbody>
                    <tr>
                        <th>ID</th>
                        <td>{{ inscription.id }}</td>
                    </tr>
                    <tr>
                        <th>Nom</th>
                        <td>{{ inscription.nomClient }}</td>
                    </tr>
                    <tr>
                        <th>Prénom</th>
                        <td>{{ inscription.prenomClient }}</td>
                    </tr>
                    <tr>
                        <th>Email</th>
                        <td>{{ inscription.email }}</td>
                    </tr>
                    <tr>
                        <th>Téléphone</th>
                        <td>{{ inscription.telephone }}</td>
                    </tr>
                    <tr>
                        <th>Date de naissance</th>
                        <td>{{ inscription.dateNaissance|date('d/m/Y') }}</td>
                    </tr>
                    <tr>
                        <th>Secteur d'activité</th>
                        <td>{{ inscription.secteurActivite }}</td>
                    </tr>
                    <tr>
                        <th>Type</th>
                        <td>{{ inscription.type }}</td>
                    </tr>
                    <tr>
                        <th>Date d'inscription</th>
                        <td>{{ inscription.dateInscription|date('d/m/Y H:i') }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <a href="{{ path('responsable_inscription_index') }}" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Retour à la liste
        </a>
        
    </div>
</div>
{% endblock %}