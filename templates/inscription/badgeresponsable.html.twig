<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Badge Événement - Impression Fidèle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        :root {
            --primary-blue:rgb(58, 119, 194);
            --secondary-blue:rgb(59, 173, 173);
            --accent-blue:rgb(36, 102, 189);
            --light-blue: #6a89cc;
            --pale-blue: #dff9fb;
            --white: #ffffff;
            --light-gray: #f8f9fa;
            --shadow: rgba(0, 0, 0, 0.08);
        }

        
        body {
            background: #f0f5f9;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 20px;
            font-family: 'Segoe UI', 'Roboto', sans-serif;
            color: #333;
        }
        
        .badge-container {
            width: 500px;
            background: var(--white);
            border-radius: 18px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            position: relative;
            margin-bottom: 20px;
            border: 1px solid #e0e7ee;
        }
        
        .badge-header {
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--secondary-blue) 100%);
            color: var(--white);
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: relative;
        }
        
        .header-content {
            display: flex;
            align-items: center;
            gap: 15px;
            position: relative;
            z-index: 2;
            width: 100%;
            justify-content: space-between;
        }
        
        .header-logo {
            display: flex;
            align-items: center;
             gap: 200px;
        }
        
        .badge-header img {
            height: 40px;
        }
        
        .badge-number {
            background: var(--accent-blue);
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            font-weight: bold;
            color: var(--white);
            border: 2px solid rgba(255, 255, 255, 0.5);
        }
        
        .badge-main {
            padding: 25px;
            position: relative;
            background:  #f0f5f9;
        }
        
        .event-title {
            color: var(--primary-blue);
            font-size: 24px;
            margin-bottom: 20px;
            text-align: center;
            position: relative;
            padding-bottom: 15px;
            font-weight: 700;
        }
        
        .event-title::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 3px;
            background: var(--accent-blue);
            border-radius: 2px;
        }
        
        .logo-container {
            display: flex;
            justify-content: center;
            margin: 20px 0;
            position: relative;
            z-index: 2;
        }
        
        .logo-container img {
            max-height: 90px;
            max-width: 200px;
            object-fit: contain;
            padding: 10px;
        }
        
        .participant-info {
            text-align: center;
            margin: 20px 0;
            position: relative;
            z-index: 2;
        }
        
        .participant-name {
            font-size: 26px;
            color: var(--primary-blue);
            font-weight: bold;
            margin-bottom: 10px;
            font-family: 'Georgia', serif;
        }
        
        .participant-type {
            font-size: 18px;
            color: var(--white);
            font-weight: 600;
            background: var(--accent-blue);
            display: inline-block;
            padding: 8px 25px;
            border-radius: 50px;
            margin-bottom: 15px;
            border: 2px solid var(--white);
        }
        
        .event-details {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
            margin: 20px 0;
            position: relative;
            z-index: 2;
        }
        
        .detail-card {
            background: var(--light-gray);
            padding: 15px;
            border-radius: 12px;
            min-width: 200px;
            text-align: center;
            box-shadow: 0 4px 8px var(--shadow);
            border: 1px solid #e9ecef;
        }
        
        .detail-card h3 {
            color: var(--secondary-blue);
            font-size: 14px;
            margin-bottom: 10px;
            font-weight: 600;
            text-transform: uppercase;
        }
        
        .detail-card div {
            font-size: 16px;
            color: var(--primary-blue);
            font-weight: 500;
        }
        
        .badge-sponsors {
            background: var(--light-gray);
            padding: 20px;
            border-top: 1px solid #e0e7ee;
            position: relative;
            z-index: 2;
        }
        
        .sponsors-title {
            text-align: center;
            color: var(--primary-blue);
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 15px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        
        .sponsors-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 15px;
        }
        
        .sponsors-container > div {
            flex: 1;
            min-width: 80px;
            max-width: 80px;
            background: var(--white);
            padding: 12px;
            border-radius: 10px;
            box-shadow: 0 4px 8px var(--shadow);
        }
        
        .sponsors-container img {
            max-width: 60%;
            max-height: 60px;
            object-fit: contain;
        }
        
        .print-button {
            background: var(--primary-blue);
            color: var(--white);
            border: none;
            padding: 12px 30px;
            font-size: 16px;
            border-radius: 50px;
            cursor: pointer;
            font-weight: 600;
            margin-top: 20px;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: background 0.3s;
        }
        
        .print-button:hover {
            background: var(--secondary-blue);
        }

        
        
        .watermark {
            position: absolute;
            bottom: 15px;
            right: 15px;
            opacity: 0.08;
            font-size: 120px;
            font-weight: 900;
            color: var(--primary-blue);
            z-index: 0;
            pointer-events: none;
            transform: rotate(-15deg);
            font-family: 'Arial Black', sans-serif;
        }

        .button-container {
    margin-top: 20px;
}

.back-btn {
    background: var(--primary-blue);
    color: var(--white);
    border: none;
    padding: 12px 30px;
    font-size: 16px;
    border-radius: 50px;
    cursor: pointer;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: background 0.3s;
    text-decoration: none;
}

.back-btn:hover {
    background: var(--secondary-blue);
}
        
        /* Styles spécifiques pour l'impression */
        @media print {
            body {
                background: white !important;
                padding: 0 !important;
                margin: 0 !important;
                min-height: auto !important;
                display: block !important;
            }

            .header-logo {
                 gap: 200px !important; /* Gap appliqué uniquement à l'impression */
             }
            
            .print-button {
                display: none !important;
            }

            .print-button, .no-print {
        display: none !important;
    }
            
            .badge-container {
                box-shadow: none !important;
                margin: 0 !important;
                border-radius: 0 !important;
                width: 100% !important;
                max-width: 100% !important;
                border: none !important;
                page-break-inside: avoid;
            }
            
            /* Forcer les couleurs pour l'impression */
            .badge-header {
                background: linear-gradient(135deg, var(--primary-blue) 0%, var(--secondary-blue) 100%) !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
                color: white !important;
                padding: 20px !important;
                 justify-content: space-between !important;
             }
            
              .header-logo {
               gap: 200px !important;
            }
            
            
            
            .badge-number {
                background: var(--accent-blue) !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
                color: white !important;
                 border-radius: 50% !important;
                width: 50px !important;
                 height: 50px !important;

            }

            .badge-header img {
                height: 40px !important;
             }
            
            .participant-type {
                background: var(--accent-blue) !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
                color: white !important;
                border: 2px solid var(--white) !important;
            }
            
            .detail-card {
                background: var(--light-gray) !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
            
            .badge-sponsors {
                background: var(--light-gray) !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
            
            .sponsors-container > div {
                background: var(--white) !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
            
            .watermark {
                opacity: 0.08 !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
            
            /* Supprimer les animations */
            * {
                transition: none !important;
                animation: none !important;
            }
            
            /* Ajustements typographiques pour l'impression */
            .event-title,
            .participant-name,
            .detail-card div {
                color: var(--primary-blue) !important;
            }
            
            .detail-card h3 {
                color: var(--secondary-blue) !important;
            }
        }
        
        @media (max-width: 550px) {
            .badge-container {
                width: 95%;
                max-width: 95%;
            }
            
            .event-details {
                flex-direction: column;
                align-items: center;
            }
            
            .detail-card {
                width: 90%;
                min-width: unset;
            }

           
        }



       
    </style>
</head>
<body>
    <div class="badge-container">
        <div class="badge-header">
            <div class="header-content">
                <div class="header-logo">
                    <img src="{{ asset('uploads/logos/medinnalogo.png') }}" alt="Logo par défaut">
                    <div class="badge-number">21</div>
                </div>
            </div>
        </div>
        
        <div class="badge-main">
            <h2 class="event-title">{{ event.titre }}</h2>
            
            <div class="logo-container">
                {% if event.logo %}
                    <img src="{{ asset('uploads/logos/' ~ event.logo) }}" alt="{{ event.titre }}">
                {% endif %}
            </div>
            
            <div class="participant-info">
                <div class="participant-name">{{ inscription.prenomClient }} {{ inscription.nomClient }}</div>
                <div class="participant-type">{{ inscription.type }}</div>
            </div>
            
            <div class="event-details">
                <div class="detail-card">
                    <h3>DATE DE L'ÉVÉNEMENT</h3>
                    <div>{{ event.dateDebut|date('d/m/Y') }} - {{ event.dateFin|date('d/m/Y') }}</div>
                </div>
                
                <div class="detail-card">
                    <h3>LIEU</h3>
                    <div>{{ event.lieu }}</div>
                </div>
            </div>
            
            <div class="watermark">EVENT</div>
        </div>
        
        <div class="badge-sponsors">
            <div class="sponsors-title">Nos Sponsors</div>
            <div class="sponsors-container">
                {% if event.logoSponsor is iterable %}
                    {% for logo in event.logoSponsor|slice(0, 20) %}
                        <div>
                            <img src="{{ asset('uploads/sponsors/' ~ logo) }}" alt="Sponsor">
                        </div>
                    {% endfor %}
                {% else %}
                    {% if event.logoSponsor %}
                        <div>
                            <img src="{{ asset('uploads/sponsors/' ~ event.logoSponsor) }}" alt="Sponsor">
                        </div>
                    {% endif %}
                {% endif %}
            </div>
        </div>
    </div>

    <button class="print-button" onclick="window.print()">
        <i class="fas fa-print"></i> Imprimer le badge
    </button>

    <!-- Bouton de retour au tableau de bord -->
    <div class="button-container  no-print">
        <a href="{{ path('responsable_inscription_index') }}" class="back-btn">
            <i class="fas fa-arrow-left"></i>Retour
        </a>
    </div>
</body>
</html>