<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modifier inscription</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --primary-blue: #1a73e8;
            --secondary-blue: #4285f4;
            --light-blue: #e8f0fe;
            --dark-blue: #0d47a1;
            --white: #ffffff;
            --light-gray: #f5f7fa;
            --border-color: #dadce0;
            --text-color: #202124;
            --shadow: 0 4px 12px rgba(0, 0, 0, 0.08);
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        }
        
        body {
            background: linear-gradient(135deg, var(--light-blue) 0%, var(--white) 100%);
            min-height: 100vh;
            padding: 20px;
            color: var(--text-color);
        }
        
        .container {
            max-width: 1200px;
            margin: 30px auto;
        }
        
        .header {
            text-align: center;
            margin-bottom: 40px;
            padding: 20px 0;
        }
        
        .header h1 {
            color: var(--dark-blue);
            font-size: 2.5rem;
            margin-bottom: 10px;
            position: relative;
            display: inline-block;
        }
        
        .header h1:after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 80px;
            height: 4px;
            background: var(--primary-blue);
            border-radius: 2px;
        }
        
        .card {
            background: var(--white);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: var(--shadow);
            border: none;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        
        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
        }
        
        .card-header {
            background: linear-gradient(to right, var(--primary-blue), var(--secondary-blue));
            color: var(--white);
            padding: 20px 30px;
            font-size: 1.4rem;
            font-weight: 600;
        }
        
        .card-body {
            padding: 40px;
        }
        
        .form-label {
            font-weight: 600;
            color: var(--dark-blue);
            margin-bottom: 8px;
            display: block;
        }
        
        .form-label.required:after {
            content: " *";
            color: #e53935;
        }
        
        .form-control, .form-select {
            width: 100%;
            padding: 14px 16px;
            border: 2px solid var(--border-color);
            border-radius: 8px;
            font-size: 1rem;
            transition: all 0.3s ease;
            background-color: var(--light-gray);
        }
        
        .form-control:focus, .form-select:focus {
            border-color: var(--primary-blue);
            box-shadow: 0 0 0 3px rgba(26, 115, 232, 0.2);
            outline: none;
            background-color: var(--white);
        }
        
        .row {
            display: flex;
            flex-wrap: wrap;
            margin: 0 -15px;
        }
        
        .col-md-6 {
            padding: 0 15px;
            flex: 0 0 50%;
            max-width: 50%;
            margin-bottom: 25px;
        }
        
        .btn {
            padding: 12px 28px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            border: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
        }
        
        .btn i {
            margin-right: 8px;
        }
        
        .btn-success {
            background: linear-gradient(to right, var(--primary-blue), var(--secondary-blue));
            color: var(--white);
            box-shadow: 0 4px 6px rgba(26, 115, 232, 0.3);
        }
        
        .btn-success:hover {
            background: linear-gradient(to right, var(--dark-blue), var(--primary-blue));
            box-shadow: 0 6px 10px rgba(26, 115, 232, 0.4);
            transform: translateY(-2px);
        }
        
        .btn-secondary {
            background: var(--white);
            color: var(--primary-blue);
            border: 2px solid var(--primary-blue);
        }
        
        .btn-secondary:hover {
            background: var(--light-blue);
            transform: translateY(-2px);
        }
        
        .actions {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 30px;
        }
        
        @media (max-width: 768px) {
            .col-md-6 {
                flex: 0 0 100%;
                max-width: 100%;
            }
            
            .actions {
                flex-direction: column;
                align-items: center;
            }
            
            .btn {
                width: 100%;
            }
        }
        
        .form-icon {
            position: relative;
        }
        
        .form-icon i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--primary-blue);
            font-size: 18px;
        }
        
        .form-icon .form-control,
        .form-icon .form-select {
            padding-left: 45px;
        }
        
        .decoration {
            position: absolute;
            width: 200px;
            height: 200px;
            border-radius: 50%;
            background: linear-gradient(135deg, rgba(26, 115, 232, 0.1) 0%, rgba(66, 133, 244, 0.05) 100%);
            z-index: -1;
        }
        
        .decoration-1 {
            top: 10%;
            left: 5%;
        }
        
        .decoration-2 {
            bottom: 10%;
            right: 5%;
        }
    </style>
</head>
<body>
    <div class="decoration decoration-1"></div>
    <div class="decoration decoration-2"></div>
    
    <div class="container">
        <div class="header">
            <h1>Modifier l'inscription</h1>
            <p>Mettez à jour les informations de cette inscription</p>
        </div>
        
        <div class="card">
            <div class="card-header">
                <i class="fas fa-user-edit"></i> Formulaire de modification
            </div>
            <div class="card-body">
                <form method="post">
                    <div class="row">
                        <div class="col-md-6">
                            <label for="nomClient" class="form-label required">Nom</label>
                            <div class="form-icon">
                                <i class="fas fa-user"></i>
                                <input type="text" class="form-control" id="nomClient" name="nomClient" value="{{ inscription.nomClient }}" required placeholder="Entrez votre nom">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="prenomClient" class="form-label required">Prénom</label>
                            <div class="form-icon">
                                <i class="fas fa-user"></i>
                                <input type="text" class="form-control" id="prenomClient" name="prenomClient" value="{{ inscription.prenomClient }}" required placeholder="Entrez votre prénom">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="email" class="form-label required">Email</label>
                            <div class="form-icon">
                                <i class="fas fa-envelope"></i>
                                <input type="email" class="form-control" id="email" name="email" value="{{ inscription.email }}" required placeholder="exemple@email.com">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="telephone" class="form-label required">Téléphone</label>
                            <div class="form-icon">
                                <i class="fas fa-phone"></i>
                                <input type="tel" class="form-control" id="telephone" name="telephone" value="{{ inscription.telephone }}" required placeholder="Entrez votre numéro de téléphone">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="dateNaissance" class="form-label required">Date de naissance</label>
                            <div class="form-icon">
                                <i class="fas fa-calendar-alt"></i>
                                <input type="date" class="form-control" id="dateNaissance" name="dateNaissance" value="{{ inscription.dateNaissance|date('Y-m-d') }}" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="secteur_Activite" class="form-label required">Secteur d'activité</label>
                            <div class="form-icon">
                                <i class="fas fa-briefcase"></i>
                                <input type="text" class="form-control" id="secteur_Activite" name="secteur_Activite" value="{{ inscription.secteurActivite }}" required placeholder="Votre secteur d'activité">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="nationalite" class="form-label required">Nationalité</label>
                            <div class="form-icon">
                                <i class="fas fa-globe"></i>
                                <input type="text" class="form-control" id="nationalite" name="nationalite" value="{{ inscription.nationalite }}" required placeholder="Votre nationalité">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="type" class="form-label required">Type</label>
                            <div class="form-icon">
                                <i class="fas fa-tag"></i>
                                <select class="form-select" id="type" name="type" required>
                                    <option value="">Sélectionnez un type</option>
                                    <option value="Exposant" {{ inscription.type == 'Exposant' ? 'selected' : '' }}>Exposant</option>
                                    <option value="Visiteur" {{ inscription.type == 'Visiteur' ? 'selected' : '' }}>Visiteur</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="event" class="form-label required">Événement</label>
                            <div class="form-icon">
                                <i class="fas fa-calendar-check"></i>
                                <select class="form-select" id="event" name="event" required>
                                    <option value="">Sélectionnez un événement</option>
                                    {% for event in events %}
                                        <option value="{{ event.id }}" {{ event.id == inscription.event.id ? 'selected' : '' }}>
                                            {{ event.titre }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                    </div>
                    
                    <div class="actions">
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-save"></i> Mettre à jour
                        </button>
                        <a href="{{ path('app_inscription_index') }}" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Retour
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>